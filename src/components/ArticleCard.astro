---
import type { ParsedArticle } from '../utils/articles';
import { siteConfig } from '../site.config';

interface Props {
  article: ParsedArticle;
  showCategory?: boolean;
}

const { article, showCategory = true } = Astro.props;
const categoryConfig = siteConfig.categories[article.category];
const categoryTitle = categoryConfig?.title || article.category;
---

<article class="group py-6 first:pt-2 border-b border-primary/10 last:border-b-0 transition-colors">
  <!-- Meta Row: Category + Date + Reading Time -->
  <div class="flex flex-wrap items-center gap-2.5 text-xs text-secondary mb-2.5">
    {showCategory && (
      <a
        href={`/${article.category}`}
        class="inline-flex items-center gap-1.5 rounded-full border border-primary/10 bg-primary/[0.03] px-2.5 py-0.5 text-xs font-medium text-foreground/90 transition-colors hover:bg-primary/[0.06] hover:border-primary/20"
      >
        <span class="h-1.5 w-1.5 rounded-full bg-primary/60 shrink-0" aria-hidden="true"></span>
        <span>{categoryTitle}</span>
      </a>
    )}

    {article.formattedDate && (
      <time datetime={article.date} class="text-secondary font-normal">
        {article.formattedDate}
      </time>
    )}

    {article.formattedDate && <span class="text-primary/20">•</span>}

    <span>{article.readingTime}</span>

    {article.draft && (
      <span class="inline-flex items-center rounded border border-amber-300 bg-amber-50 px-1.5 py-0.2 text-[10px] font-medium text-amber-800">
        Draft
      </span>
    )}
  </div>

  <!-- Title -->
  <h3 class="text-lg sm:text-xl font-semibold leading-snug text-primary group-hover:text-primary/80 transition-colors">
    <a href={article.url} class="focus:outline-none focus:underline">
      {article.title}
    </a>
  </h3>

  <!-- Description -->
  {article.description && (
    <p class="mt-2 text-sm text-secondary leading-relaxed line-clamp-2">
      {article.description}
    </p>
  )}

  <!-- Tags -->
  {article.tags && article.tags.length > 0 && (
    <div class="mt-3.5 flex flex-wrap items-center gap-1.5">
      {article.tags.map((tag) => (
        <span class="inline-flex items-center rounded-full border border-primary/10 bg-surface px-2 py-0.5 text-[11px] font-medium text-secondary">
          #{tag}
        </span>
      ))}
    </div>
  )}
</article>
