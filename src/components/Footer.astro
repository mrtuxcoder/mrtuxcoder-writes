---
import { siteConfig } from '../site.config';

const currentYear = new Date().getFullYear();
---

<footer class="border-t border-primary/10 bg-surface/40 pt-8 pb-24 sm:pb-28 lg:pb-8 px-4 sm:px-8 mt-auto text-xs text-secondary">
  <div class="flex flex-col sm:flex-row items-center justify-between gap-4">
    <!-- Left Copyright & Attribution -->
    <div class="flex flex-wrap items-center justify-center sm:justify-start gap-2 sm:gap-3 text-center sm:text-left">
      <span class="font-medium text-primary">
        {siteConfig.author}
      </span>
      <span class="text-primary/20">|</span>
      <span>
        © {currentYear} {siteConfig.siteName}. All rights reserved.
      </span>
    </div>

    <!-- Right Links -->
    <div class="flex items-center gap-4 sm:gap-5">
      <a
        href={siteConfig.portfolioUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="group hover:text-primary transition-colors flex items-center gap-1"
      >
        <span>visit {siteConfig.portfolioLabel}</span>
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-3 w-3 text-secondary group-hover:text-primary transition-transform duration-200 group-hover:translate-x-0.5 shrink-0"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
        </svg>
      </a>
    </div>
  </div>
</footer>
