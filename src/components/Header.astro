---
import { siteConfig } from '../site.config';

interface Props {
  currentPath?: string;
}

const { currentPath = '' } = Astro.props;
---

<header class="sticky top-0 z-40 w-full border-b border-primary/15 bg-surface/90 backdrop-blur-md shadow-xs transition-colors">
  <div class="flex h-16 items-center justify-between px-4 sm:px-8">
    <!-- Brand Group -->
    <div class="flex items-center gap-2.5 sm:gap-3 shrink-0">
      <a
        href="/"
        data-astro-prefetch
        class="group flex items-center gap-2 text-sm sm:text-base font-semibold text-primary transition-opacity hover:opacity-85 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/20 rounded-md"
        aria-label="Homepage"
      >
        <span class="h-2 w-2 rounded-full bg-accent-emerald shrink-0" aria-hidden="true"></span>
        <span class="tracking-tight whitespace-nowrap">{siteConfig.siteName}</span>
      </a>
      <span class="hidden sm:inline-flex items-center rounded-full border border-primary/10 bg-primary/[0.04] px-2.5 py-0.5 text-[11px] font-medium text-secondary uppercase tracking-wider shrink-0 select-none">
        Publishing
      </span>
    </div>

    <!-- Desktop Navigation -->
    <nav class="hidden lg:flex items-center gap-1.5 xl:gap-2" aria-label="Main Navigation">
      {siteConfig.navLinks.map((link) => {
        const isActive = currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href));
        return (
          <a
            href={link.href}
            data-astro-prefetch
            class={`inline-flex items-center justify-center h-8 px-2.5 xl:px-3 rounded-md text-xs sm:text-sm font-medium transition-colors ${
              isActive
                ? 'bg-primary/[0.07] text-primary font-semibold'
                : 'text-secondary hover:text-primary hover:bg-primary/[0.03]'
            }`}
          >
            {link.label}
          </a>
        );
      })}
    </nav>

    <!-- Right Actions -->
    <div class="flex items-center gap-2 sm:gap-2.5 shrink-0">
      <!-- Search Trigger Button -->
      <button
        type="button"
        data-open-search
        class="h-8 sm:h-9 inline-flex items-center gap-2 rounded-md border border-primary/15 bg-surface px-2.5 sm:px-3 text-xs font-medium text-secondary hover:text-primary hover:border-primary/30 transition-colors focus:outline-none focus:ring-1 focus:ring-primary/20"
        aria-label="Search articles"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
        <span class="hidden sm:inline">Search</span>
        <kbd class="hidden sm:inline-block rounded border border-primary/15 bg-background px-1 py-0.5 font-mono text-[10px] text-secondary leading-none">
          /
        </kbd>
      </button>

      <!-- Portfolio Link Capsule -->
      <a
        href={siteConfig.portfolioUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="group h-8 sm:h-9 hidden sm:inline-flex items-center gap-1.5 rounded-full border border-primary/15 bg-surface px-3 text-xs font-medium text-secondary hover:text-primary hover:border-primary/30 hover:bg-primary/[0.03] transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-primary/20"
        title={`Visit ${siteConfig.portfolioLabel}`}
      >
        <span>visit {siteConfig.portfolioLabel}</span>
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-3 w-3 text-secondary group-hover:text-primary transition-transform duration-200 group-hover:translate-x-0.5 shrink-0"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
        </svg>
      </a>
    </div>
  </div>
</header>
