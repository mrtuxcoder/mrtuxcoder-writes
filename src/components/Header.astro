---
import { siteConfig } from '../site.config';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  currentPath?: string;
}

const { currentPath = '' } = Astro.props;
---

<header class="w-full pt-4 pb-3 border-b border-border/60 transition-colors">
  <div class="flex items-center justify-between gap-3">
    <!-- Brand Group -->
    <div class="flex items-center gap-2 sm:gap-3 shrink-0">
      <a
        href="/"
        data-astro-prefetch
        class="group flex items-center gap-2 text-sm font-medium text-primary transition-colors focus-visible:outline-none"
        aria-label="Notes Homepage"
      >
        <span class="flex h-7 w-7 items-center justify-center rounded-md border border-border bg-muted/60 text-primary transition-transform group-hover:scale-105">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-4 w-4"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <polyline points="4 17 10 11 4 5"></polyline>
            <line x1="12" y1="19" x2="20" y2="19"></line>
          </svg>
        </span>
        <div class="flex items-center gap-1.5 font-bold tracking-tight text-xs sm:text-sm">
          <span>guganraj.me</span>
          <span class="text-secondary/50 font-normal">/</span>
          <span class="text-secondary font-medium">notes</span>
        </div>
      </a>
    </div>

    <!-- Right Actions -->
    <div class="flex items-center gap-2 sm:gap-3">
      <!-- Expanded Search Bar Button with comfortable height -->
      <button
        type="button"
        data-open-search
        class="h-10 sm:h-10.5 w-44 sm:w-64 md:w-72 flex items-center justify-between rounded-lg border border-border bg-card hover:bg-muted/60 px-3 sm:px-3.5 text-xs sm:text-sm text-secondary hover:text-primary transition-all cursor-pointer shadow-xs focus:outline-none"
        aria-label="Search articles"
      >
        <div class="flex items-center gap-2.5 truncate">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0 text-secondary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
          <span class="hidden sm:inline text-xs sm:text-sm text-secondary/80 font-normal">Search notes & case studies...</span>
          <span class="inline sm:hidden text-xs text-secondary/80 font-normal">Search notes...</span>
        </div>
        <kbd class="hidden sm:inline-block rounded border border-border bg-muted/70 px-1.5 py-0.5 font-mono text-[11px] text-secondary leading-none shadow-2xs">
          /
        </kbd>
      </button>

      <!-- Portfolio Link -->
      <a
        href={siteConfig.portfolioUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="hidden sm:inline-flex items-center gap-1 text-xs font-semibold text-secondary hover:text-primary transition-colors py-1 px-1.5 shrink-0"
        title="Visit Portfolio"
      >
        <span>Portfolio</span>
        <span class="text-xs">↗</span>
      </a>

      <!-- Theme Toggle Button -->
      <ThemeToggle />
    </div>
  </div>
</header>
