---
interface Props {
  currentPath?: string;
}

const { currentPath = '' } = Astro.props;

const items = [
  {
    label: 'Case Studies',
    href: '/case-study',
    isActive: currentPath === '/case-study' || currentPath.startsWith('/case-study/'),
    icon: 'folder',
  },
  {
    label: 'Blogs',
    href: '/blogs',
    isActive: currentPath === '/blogs' || currentPath.startsWith('/blogs/'),
    icon: 'book',
  },
  {
    label: 'Thoughts',
    href: '/thoughts',
    isActive: currentPath === '/thoughts' || currentPath.startsWith('/thoughts/'),
    icon: 'lightbulb',
  },
];
---

<nav
  class="lg:hidden fixed bottom-4 inset-x-0 mx-auto z-40 w-fit max-w-[calc(100%-2rem)] print:hidden"
  style="bottom: max(1rem, env(safe-area-inset-bottom, 1rem));"
  aria-label="Mobile Navigation"
>
  <div class="flex items-center gap-1 rounded-full border border-primary/15 bg-surface/90 backdrop-blur-md px-1.5 py-1.5 shadow-lg shadow-primary/[0.06] select-none">
    {items.map((item) => (
      <a
        href={item.href}
        data-astro-prefetch
        class={`flex items-center gap-1.5 px-3 py-1.5 sm:px-3.5 sm:py-2 rounded-full text-xs transition-all duration-150 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/20 ${
          item.isActive
            ? 'bg-primary/[0.08] text-primary font-semibold shadow-2xs'
            : 'text-secondary hover:text-primary hover:bg-primary/[0.04] font-medium'
        }`}
        aria-current={item.isActive ? 'page' : undefined}
      >
        {item.icon === 'folder' && (
          <svg xmlns="http://www.w3.org/2000/svg" class={`h-4 w-4 shrink-0 ${item.isActive ? 'text-primary' : 'text-secondary'}`} fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z" />
          </svg>
        )}
        {item.icon === 'book' && (
          <svg xmlns="http://www.w3.org/2000/svg" class={`h-4 w-4 shrink-0 ${item.isActive ? 'text-primary' : 'text-secondary'}`} fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
          </svg>
        )}
        {item.icon === 'lightbulb' && (
          <svg xmlns="http://www.w3.org/2000/svg" class={`h-4 w-4 shrink-0 ${item.isActive ? 'text-primary' : 'text-secondary'}`} fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
          </svg>
        )}
        <span class="tracking-tight">{item.label}</span>
      </a>
    ))}
  </div>
</nav>
