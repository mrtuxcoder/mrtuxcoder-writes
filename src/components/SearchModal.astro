---
---

<div
  id="search-modal"
  class="fixed inset-0 z-50 hidden bg-primary/40 backdrop-blur-xs p-4 sm:p-6 flex items-start sm:items-center justify-center pt-12 sm:pt-0"
  role="dialog"
  aria-modal="true"
  aria-labelledby="search-label"
>
  <div class="relative w-full max-w-xl max-h-[85vh] flex flex-col rounded-xl border border-primary/15 bg-background shadow-2xl overflow-hidden">
    <!-- Header -->
    <div class="flex items-center justify-between border-b border-primary/10 px-4 py-3 sm:px-5">
      <div class="flex items-center gap-2">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-secondary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
        <span id="search-label" class="text-xs font-semibold uppercase tracking-wider text-secondary">Search Articles</span>
      </div>
      <button
        id="close-search-btn"
        type="button"
        class="h-7 w-7 inline-flex items-center justify-center rounded-md text-secondary hover:text-primary hover:bg-primary/5 focus:outline-none transition-colors"
        aria-label="Close search"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd" />
        </svg>
      </button>
    </div>

    <!-- Input Bar -->
    <div class="border-b border-primary/10 px-4 py-3 sm:px-5 bg-surface/50">
      <input
        type="search"
        id="search-input"
        placeholder="Type keywords, topics, or tags..."
        class="h-10 w-full rounded-md border border-primary/15 bg-background px-3 text-sm text-primary placeholder-secondary/60 focus:border-primary/40 focus:outline-none focus:ring-1 focus:ring-primary/20 transition-all"
        autocomplete="off"
        spellcheck="false"
      />
    </div>

    <!-- Results Area -->
    <div id="search-results" class="flex-1 overflow-y-auto px-3 py-2 sm:px-4 divide-y divide-primary/5" role="listbox">
      <p id="search-empty-state" class="py-10 text-center text-xs text-secondary">
        Search titles, descriptions, and tags. Type to begin.
      </p>
    </div>

    <!-- Footer Shortcuts -->
    <div class="flex items-center justify-between border-t border-primary/10 bg-surface/70 px-4 py-2.5 text-[11px] text-secondary">
      <div class="flex items-center gap-3">
        <span><kbd class="rounded border border-primary/15 bg-background px-1 py-0.5 font-mono text-[10px] text-primary">↑↓</kbd> navigate</span>
        <span><kbd class="rounded border border-primary/15 bg-background px-1 py-0.5 font-mono text-[10px] text-primary">↵</kbd> select</span>
      </div>
      <span><kbd class="rounded border border-primary/15 bg-background px-1 py-0.5 font-mono text-[10px] text-primary">ESC</kbd> close</span>
    </div>
  </div>
</div>

<script>
  interface SearchItem {
    title: string;
    description: string;
    url: string;
    category: string;
    tags: string[];
    date?: string;
  }

  let searchIndex: SearchItem[] | null = null;
  let filteredItems: SearchItem[] = [];
  let selectedIndex = -1;
  let lastFocusedElement: HTMLElement | null = null;

  const modal = document.getElementById('search-modal');
  const input = document.getElementById('search-input') as HTMLInputElement;
  const resultsContainer = document.getElementById('search-results');
  const closeBtn = document.getElementById('close-search-btn');

  async function loadSearchIndex() {
    if (!searchIndex) {
      try {
        const res = await fetch('/search.json');
        if (res.ok) {
          searchIndex = await res.json();
        }
      } catch (e) {
        console.error('Failed to load search index:', e);
      }
    }
  }

  function openSearch() {
    if (!modal) return;
    lastFocusedElement = document.activeElement as HTMLElement;
    modal.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
    loadSearchIndex();
    setTimeout(() => {
      input?.focus();
    }, 40);
  }

  function closeSearch() {
    if (!modal) return;
    modal.classList.add('hidden');
    document.body.style.overflow = '';
    if (input) input.value = '';
    filteredItems = [];
    selectedIndex = -1;
    renderResults([]);
    if (lastFocusedElement) {
      lastFocusedElement.focus();
    }
  }

  function performSearch(query: string) {
    if (!searchIndex || !query.trim()) {
      filteredItems = [];
      selectedIndex = -1;
      renderResults([]);
      return;
    }

    const q = query.toLowerCase().trim();
    filteredItems = searchIndex.filter((item) => {
      const matchTitle = item.title.toLowerCase().includes(q);
      const matchDesc = item.description?.toLowerCase().includes(q) || false;
      const matchCategory = item.category.toLowerCase().includes(q);
      const matchTags = item.tags.some((t) => t.toLowerCase().includes(q));
      return matchTitle || matchDesc || matchCategory || matchTags;
    });

    selectedIndex = filteredItems.length > 0 ? 0 : -1;
    renderResults(filteredItems, q);
  }

  function updateSelection() {
    if (!resultsContainer) return;
    const items = resultsContainer.querySelectorAll<HTMLAnchorElement>('[role="option"]');
    items.forEach((item, index) => {
      if (index === selectedIndex) {
        item.classList.add('bg-primary/[0.06]');
        item.setAttribute('aria-selected', 'true');
        item.scrollIntoView({ block: 'nearest' });
      } else {
        item.classList.remove('bg-primary/[0.06]');
        item.removeAttribute('aria-selected');
      }
    });
  }

  function renderResults(items: SearchItem[], query = '') {
    if (!resultsContainer) return;

    if (!query) {
      resultsContainer.innerHTML = `
        <p class="py-10 text-center text-xs text-secondary">
          Search titles, descriptions, and tags. Type to begin.
        </p>
      `;
      return;
    }

    if (items.length === 0) {
      resultsContainer.innerHTML = `
        <p class="py-10 text-center text-xs text-secondary">
          No articles found matching "<span class="text-primary font-medium">${escapeHtml(query)}</span>".
        </p>
      `;
      return;
    }

    resultsContainer.innerHTML = items
      .map(
        (item, idx) => `
      <a
        href="${item.url}"
        role="option"
        aria-selected="${idx === selectedIndex ? 'true' : 'false'}"
        class="group block py-2.5 px-3 rounded-lg transition-colors ${
          idx === selectedIndex ? 'bg-primary/[0.06]' : 'hover:bg-primary/[0.03]'
        }"
      >
        <div class="flex items-center gap-2 mb-1">
          <span class="inline-flex items-center rounded-full border border-primary/10 bg-primary/[0.04] px-2 py-0.5 text-[10px] font-medium text-secondary uppercase tracking-wider">
            ${escapeHtml(item.category)}
          </span>
          ${item.date ? `<span class="text-[11px] text-secondary font-normal">${escapeHtml(item.date)}</span>` : ''}
        </div>
        <h4 class="text-sm font-semibold text-primary group-hover:underline">
          ${escapeHtml(item.title)}
        </h4>
        ${
          item.description
            ? `<p class="mt-0.5 text-xs text-secondary line-clamp-1 leading-relaxed">${escapeHtml(item.description)}</p>`
            : ''
        }
      </a>
    `
      )
      .join('');
  }

  function escapeHtml(str: string): string {
    return str
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#039;');
  }

  // Global Keyboard shortcuts
  window.addEventListener('keydown', (e) => {
    if (e.key === '/' && !['INPUT', 'TEXTAREA'].includes((e.target as HTMLElement).tagName)) {
      e.preventDefault();
      openSearch();
    } else if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') {
      e.preventDefault();
      openSearch();
    } else if (e.key === 'Escape' && modal && !modal.classList.contains('hidden')) {
      e.preventDefault();
      closeSearch();
    }
  });

  // Modal-internal Keyboard navigation
  modal?.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowDown') {
      e.preventDefault();
      if (filteredItems.length > 0) {
        selectedIndex = (selectedIndex + 1) % filteredItems.length;
        updateSelection();
      }
    } else if (e.key === 'ArrowUp') {
      e.preventDefault();
      if (filteredItems.length > 0) {
        selectedIndex = (selectedIndex - 1 + filteredItems.length) % filteredItems.length;
        updateSelection();
      }
    } else if (e.key === 'Enter') {
      if (selectedIndex >= 0 && selectedIndex < filteredItems.length) {
        e.preventDefault();
        window.location.href = filteredItems[selectedIndex].url;
      }
    }
  });

  input?.addEventListener('input', (e) => {
    performSearch((e.target as HTMLInputElement).value);
  });

  closeBtn?.addEventListener('click', closeSearch);

  modal?.addEventListener('click', (e) => {
    if (e.target === modal) {
      closeSearch();
    }
  });

  document.querySelectorAll('[data-open-search]').forEach((btn) => {
    btn.addEventListener('click', openSearch);
  });
</script>
