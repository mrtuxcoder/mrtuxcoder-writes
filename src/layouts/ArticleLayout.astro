---
import BaseLayout from './BaseLayout.astro';
import TableOfContents from '../components/TableOfContents.astro';
import PencilDivider from '../components/PencilDivider.astro';
import type { ParsedArticle } from '../utils/articles';
import { siteConfig } from '../site.config';
import type { MarkdownHeading } from 'astro';

interface Props {
  article: ParsedArticle;
  headings: MarkdownHeading[];
  prevArticle?: ParsedArticle;
  nextArticle?: ParsedArticle;
}

const { article, headings, prevArticle, nextArticle } = Astro.props;
const categoryConfig = siteConfig.categories[article.category];
const categoryTitle = categoryConfig?.title || article.category;
---

<BaseLayout
  title={article.title}
  description={article.description || `Article in ${categoryTitle}: ${article.title}`}
  ogType="article"
  publishedTime={article.date}
  articleTags={article.tags}
>
  <article class="mx-auto max-w-3xl min-w-0 w-full space-y-7">
    <!-- Breadcrumb -->
    <div class="flex flex-wrap items-center gap-1.5 text-xs sm:text-sm text-secondary">
      <a href="/" class="hover:text-primary transition-colors flex items-center gap-1">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
        <span>Home</span>
      </a>
      <span class="text-secondary/40">/</span>
      <a href={`/${article.category}`} class="hover:text-primary transition-colors">
        {categoryTitle}
      </a>
      <span class="text-secondary/40">/</span>
      <span class="text-primary font-medium truncate max-w-[200px] sm:max-w-sm">{article.title}</span>
    </div>

    <!-- Article Header -->
    <header class="space-y-3.5 pb-2">
      <!-- Category Capsule -->
      <div class="flex flex-wrap items-center gap-2">
        <a
          href={`/${article.category}`}
          class="inline-flex min-h-[26px] items-center gap-1.5 rounded-md border border-border bg-muted px-2.5 py-0.5 text-xs font-semibold text-primary hover:bg-muted/80 transition-colors"
        >
          <span class="h-1.5 w-1.5 rounded-full bg-emerald-500 shrink-0" aria-hidden="true"></span>
          <span>{categoryTitle}</span>
        </a>

        {article.draft && (
          <span class="inline-flex items-center rounded-md border border-amber-500/40 bg-amber-500/10 px-2 py-0.5 text-[11px] font-medium text-amber-600 dark:text-amber-400">
            Draft Preview
          </span>
        )}
      </div>

      <!-- Article Title -->
      <h1 class="text-2xl sm:text-4xl font-extrabold tracking-tight text-primary leading-tight">
        {article.title}
      </h1>

      <!-- Description -->
      {article.description && (
        <p class="text-base sm:text-lg text-secondary leading-relaxed pt-1">
          {article.description}
        </p>
      )}

      <!-- Meta Row -->
      <div class="flex flex-wrap items-center gap-2.5 text-xs sm:text-sm text-secondary pt-1 font-medium">
        {article.formattedDate && (
          <time datetime={article.date} class="text-secondary">
            {article.formattedDate}
          </time>
        )}

        {article.formattedDate && <span class="text-secondary/40">•</span>}

        <span class="font-mono">{article.readingTime}</span>

        {article.tags && article.tags.length > 0 && (
          <>
            <span class="text-secondary/40">•</span>
            <div class="flex flex-wrap items-center gap-1.5">
              {article.tags.map((tag) => (
                <span class="rounded-md border border-border/70 bg-muted px-2 py-0.5 text-[11px] font-mono text-secondary">
                  #{tag}
                </span>
              ))}
            </div>
          </>
        )}
      </div>
    </header>

    <!-- Table of Contents -->
    {headings && headings.length > 0 && <TableOfContents headings={headings} />}

    <!-- Rendered Markdown Body -->
    <div class="prose max-w-none min-w-0 text-foreground prose-headings:scroll-mt-20 prose-img:rounded-xl prose-img:border prose-img:border-border prose-img:mx-auto">
      <slot />
    </div>

    <PencilDivider />

    <!-- Article Footer / Navigation -->
    <footer class="space-y-6 pt-2">
      <!-- Previous / Next Navigation -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
        {prevArticle ? (
          <a
            href={prevArticle.url}
            class="group flex flex-col justify-between rounded-xl border border-border bg-card p-4 sm:p-5 transition-all hover:border-primary/40 hover:bg-muted/40"
          >
            <span class="flex items-center gap-1 text-xs text-secondary mb-1.5">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
              </svg>
              <span>Previous Article</span>
            </span>
            <span class="text-sm sm:text-base font-bold text-primary group-hover:text-primary transition-colors line-clamp-2">
              {prevArticle.title}
            </span>
          </a>
        ) : (
          <div></div>
        )}

        {nextArticle ? (
          <a
            href={nextArticle.url}
            class="group flex flex-col justify-between items-end text-right rounded-xl border border-border bg-card p-4 sm:p-5 transition-all hover:border-primary/40 hover:bg-muted/40"
          >
            <span class="flex items-center gap-1 text-xs text-secondary mb-1.5">
              <span>Next Article</span>
              <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </span>
            <span class="text-sm sm:text-base font-bold text-primary group-hover:text-primary transition-colors line-clamp-2">
              {nextArticle.title}
            </span>
          </a>
        ) : (
          <div></div>
        )}
      </div>

      <!-- Back to category link -->
      <div class="text-center pt-2">
        <a
          href={`/${article.category}`}
          class="inline-flex items-center gap-1.5 rounded-lg border border-border bg-card px-4 py-2 text-xs sm:text-sm font-semibold text-secondary hover:text-primary hover:bg-muted transition-colors"
        >
          <span>View all {categoryTitle}</span>
          <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      </div>
    </footer>
  </article>

  <!-- Script to add copy buttons to all code blocks -->
  <script is:inline>
    function setupCodeCopyButtons() {
      const codeBlocks = document.querySelectorAll('pre.astro-code');
      codeBlocks.forEach((block) => {
        if (block.querySelector('.copy-code-btn')) return;

        const wrapper = document.createElement('div');
        wrapper.className = 'absolute top-3 right-3 z-10';

        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'copy-code-btn flex items-center justify-center h-7 w-7 rounded-md border border-border bg-card text-secondary hover:text-primary hover:bg-muted backdrop-blur-xs transition-colors text-xs cursor-pointer shadow-xs';
        btn.setAttribute('aria-label', 'Copy code');
        btn.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>`;

        btn.addEventListener('click', async () => {
          const code = block.querySelector('code')?.innerText || '';
          try {
            await navigator.clipboard.writeText(code);
            btn.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>`;
            setTimeout(() => {
              btn.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>`;
            }, 2000);
          } catch {}
        });

        wrapper.appendChild(btn);
        block.appendChild(wrapper);
      });
    }

    setupCodeCopyButtons();
    document.addEventListener('astro:after-swap', setupCodeCopyButtons);
    document.addEventListener('astro:page-load', setupCodeCopyButtons);
  </script>
</BaseLayout>
