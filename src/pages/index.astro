---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import PencilDivider from '../components/PencilDivider.astro';
import { getRecentArticles, getAllArticles } from '../utils/articles';
import { siteConfig } from '../site.config';

const recentArticles = await getRecentArticles(10);
const allArticles = await getAllArticles();
---

<BaseLayout
  title="Notes & Case Studies"
  description="Engineering case studies, cloud infrastructure breakdowns, and technical notes by Guganraj Rengaraju."
>
  <div class="space-y-7 sm:space-y-8">
    <!-- Hero / Introduction -->
    <section class="space-y-3.5">
      <div class="flex items-center gap-2">
        <span class="inline-flex items-center gap-1.5 rounded-md border border-border bg-muted px-2.5 py-1 text-xs font-medium text-secondary">
          <span class="h-2 w-2 rounded-full bg-emerald-500 animate-pulse shrink-0" aria-hidden="true"></span>
          <span>Notes & Engineering Explorations</span>
        </span>
      </div>

      <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-primary leading-tight">
        Things I build, learn, explore, and think about.
      </h1>

      <p class="text-sm sm:text-base text-secondary leading-relaxed max-w-2xl">
        A personal archive of cloud infrastructure, production system architectures, open-source work, and technical discoveries by <a href={siteConfig.portfolioUrl} target="_blank" class="text-primary hover:text-emerald-500 underline underline-offset-3 font-semibold transition-colors">{siteConfig.author}</a>.
      </p>

      <!-- Category Filter Pills -->
      <div class="flex flex-wrap items-center gap-2 pt-2">
        <a
          href="/"
          class="rounded-lg border border-primary/20 bg-muted px-3 py-1 text-xs sm:text-sm font-semibold text-primary shadow-xs"
        >
          All
        </a>
        {Object.values(siteConfig.categories).map((cat) => (
          <a
            href={`/${cat.slug}`}
            class="rounded-lg border border-border bg-card px-3 py-1 text-xs sm:text-sm font-medium text-secondary hover:text-primary hover:bg-muted/70 transition-colors"
          >
            {cat.title}
          </a>
        ))}
      </div>
    </section>

    <PencilDivider />

    <!-- Recent Articles Feed -->
    <section class="space-y-4">
      <div class="flex items-center justify-between">
        <h2 class="text-xs sm:text-sm font-bold tracking-tight text-primary uppercase tracking-wider">
          Recent Writing
        </h2>
        <span class="text-xs text-secondary font-mono">
          {allArticles.length} article{allArticles.length === 1 ? '' : 's'}
        </span>
      </div>

      {recentArticles.length === 0 ? (
        <div class="py-12 text-center rounded-xl border border-dashed border-border">
          <p class="text-sm text-secondary">Articles coming soon.</p>
        </div>
      ) : (
        <div class="space-y-3.5">
          {recentArticles.map((article) => (
            <ArticleCard article={article} />
          ))}
        </div>
      )}
    </section>
  </div>
</BaseLayout>
