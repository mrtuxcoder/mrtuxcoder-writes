---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { getRecentArticles, getAllArticles } from '../utils/articles';
import { siteConfig } from '../site.config';

const recentArticles = await getRecentArticles(6);
const allArticles = await getAllArticles();

// Compute counts per category
const counts: Record<string, number> = {};
for (const [key] of Object.entries(siteConfig.categories)) {
  counts[key] = allArticles.filter((a) => a.category === key).length;
}
---

<BaseLayout
  title="Home"
  description="Technical blogs, tutorials, infrastructure case studies, and engineering thoughts."
>
  <div class="space-y-12">
    <!-- Hero / Introduction -->
    <section class="border-b border-primary/10 pb-10">
      <div class="flex items-center gap-2 mb-3">
        <span class="inline-flex items-center gap-1.5 rounded-full border border-primary/10 bg-primary/[0.03] px-3 py-1 text-xs font-medium text-secondary">
          <span class="h-2 w-2 rounded-full bg-accent-emerald shrink-0" aria-hidden="true"></span>
          <span>Technical Publishing & Notes</span>
        </span>
      </div>

      <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-primary sm:leading-tight">
        Engineering notes, infrastructure deep dives & systems architecture.
      </h1>

      <p class="mt-4 max-w-2xl text-base sm:text-lg text-secondary leading-relaxed">
        A static publishing space by <strong class="font-medium text-primary">{siteConfig.author}</strong> documenting production experiments, homelab automation, Linux systems, container orchestration, and practical engineering thoughts.
      </p>

      <div class="mt-6 flex flex-wrap items-center gap-3">
        <a
          href={siteConfig.portfolioUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 rounded-md border border-primary/15 bg-surface px-3.5 py-1.5 text-xs font-medium text-primary hover:border-primary/30 hover:bg-primary/[0.03] transition-colors"
        >
          <span>Main Portfolio ({siteConfig.portfolioLabel})</span>
          <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 text-secondary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>

        <a
          href="/about"
          class="inline-flex items-center gap-1.5 rounded-md border border-transparent px-3 py-1.5 text-xs font-medium text-secondary hover:text-primary transition-colors"
        >
          <span>About this site →</span>
        </a>
      </div>
    </section>

    <!-- Categories Overview -->
    <section>
      <div class="flex items-center justify-between mb-4">
        <h2 class="text-xs font-semibold uppercase tracking-wider text-secondary">
          Browse by Category
        </h2>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
        {Object.entries(siteConfig.categories).map(([key, cat]) => (
          <a
            href={`/${key}`}
            class="group rounded-lg border border-primary/10 bg-surface/60 p-4 transition-all duration-150 hover:border-primary/30 hover:bg-surface"
          >
            <div class="flex items-center justify-between">
              <h3 class="text-sm font-semibold text-primary group-hover:underline">
                {cat.title}
              </h3>
              <span class="rounded-full bg-primary/5 px-2 py-0.5 text-[11px] font-medium text-secondary">
                {counts[key] || 0}
              </span>
            </div>
            <p class="mt-2 text-xs text-secondary leading-relaxed line-clamp-2">
              {cat.description}
            </p>
          </a>
        ))}
      </div>
    </section>

    <!-- Recent Articles Feed -->
    <section>
      <div class="flex items-center justify-between border-b border-primary/10 pb-3 mb-2">
        <h2 class="text-xs font-semibold uppercase tracking-wider text-secondary">
          Recent Articles
        </h2>
        <span class="text-xs text-secondary">
          {allArticles.length} total publication{allArticles.length === 1 ? '' : 's'}
        </span>
      </div>

      {recentArticles.length === 0 ? (
        <p class="py-12 text-center text-sm text-secondary">
          No articles published yet. Add Markdown files to <code class="text-xs bg-surface px-1 py-0.5 rounded">content/</code>.
        </p>
      ) : (
        <div class="divide-y divide-primary/10">
          {recentArticles.map((article) => (
            <ArticleCard article={article} />
          ))}
        </div>
      )}
    </section>
  </div>
</BaseLayout>
