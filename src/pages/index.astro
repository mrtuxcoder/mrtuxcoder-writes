---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { getRecentArticles, getAllArticles } from '../utils/articles';
import { siteConfig } from '../site.config';

const recentArticles = await getRecentArticles(6);
const allArticles = await getAllArticles();

// Compute counts per category
const counts: Record<string, number> = {};
for (const [key] of Object.entries(siteConfig.categories)) {
  counts[key] = allArticles.filter((a) => a.category === key).length;
}
---

<BaseLayout
  title="Home"
  description="Things I build, learn, explore, and think about."
>
  <div class="space-y-10 sm:space-y-12">
    <!-- Hero / Introduction -->
    <section class="border-b border-primary/10 pb-8 sm:pb-10">
      <div class="flex items-center gap-2 mb-3.5">
        <span class="inline-flex items-center gap-1.5 rounded-full border border-primary/10 bg-primary/[0.03] px-2.5 py-1 text-xs font-medium text-secondary">
          <span class="h-1.5 w-1.5 rounded-full bg-accent-emerald shrink-0" aria-hidden="true"></span>
          <span>Notes & Explorations</span>
        </span>
      </div>

      <h1 class="text-2xl sm:text-4xl font-bold tracking-tight text-primary leading-tight sm:leading-snug max-w-2xl">
        Things I build, learn, explore, and think about.
      </h1>

      <p class="mt-3.5 max-w-2xl text-sm sm:text-base text-secondary leading-relaxed">
        A little corner of the internet for projects, useful discoveries, personal thoughts, and things worth sharing—from technology and systems to everyday curiosities.
      </p>

      <div class="mt-6 flex flex-wrap items-center gap-2.5 sm:gap-3">
        <a
          href={siteConfig.portfolioUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="h-8 sm:h-9 inline-flex items-center gap-1.5 rounded-md border border-primary/15 bg-surface px-3 text-xs font-medium text-primary hover:border-primary/30 hover:bg-primary/[0.03] transition-colors"
        >
          <span>Main Portfolio ({siteConfig.portfolioLabel})</span>
          <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 text-secondary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>
      </div>
    </section>

    <!-- Categories Overview -->
    <section>
      <div class="flex items-center justify-between mb-4">
        <h2 class="text-xs font-semibold uppercase tracking-wider text-secondary">
          Categories
        </h2>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3.5">
        {Object.entries(siteConfig.categories).map(([key, cat]) => (
          <a
            href={`/${key}`}
            class="group rounded-lg border border-primary/10 bg-surface/50 p-4 sm:p-5 transition-all duration-150 hover:border-primary/25 hover:bg-surface flex flex-col justify-between"
          >
            <div>
              <div class="flex items-center justify-between gap-2">
                <h3 class="text-sm font-semibold text-primary group-hover:underline">
                  {cat.title}
                </h3>
                {counts[key] > 0 && (
                  <span class="rounded-full border border-primary/10 bg-background px-2 py-0.5 text-[11px] font-medium text-secondary">
                    {counts[key]}
                  </span>
                )}
              </div>
              <p class="mt-2 text-xs text-secondary leading-relaxed">
                {cat.description}
              </p>
            </div>
            <div class="mt-3 pt-2 flex items-center text-[11px] text-secondary font-medium group-hover:text-primary transition-colors">
              <span>Browse {cat.title}</span>
              <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 ml-1 transform group-hover:translate-x-0.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- Recent Articles Feed -->
    <section>
      <div class="flex items-center justify-between border-b border-primary/10 pb-3 mb-2">
        <h2 class="text-xs font-semibold uppercase tracking-wider text-secondary">
          Recent Writing
        </h2>
        <span class="text-xs text-secondary">
          {allArticles.length} article{allArticles.length === 1 ? '' : 's'}
        </span>
      </div>

      {recentArticles.length === 0 ? (
        <p class="py-10 text-center text-xs text-secondary">
          Articles coming soon.
        </p>
      ) : (
        <div class="divide-y divide-primary/10">
          {recentArticles.map((article) => (
            <ArticleCard article={article} />
          ))}
        </div>
      )}
    </section>
  </div>
</BaseLayout>
