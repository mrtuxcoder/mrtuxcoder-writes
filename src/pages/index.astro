---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import PencilDivider from '../components/PencilDivider.astro';
import { getRecentArticles, getAllArticles } from '../utils/articles';
import { siteConfig } from '../site.config';

const recentArticles = await getRecentArticles(10);
const allArticles = await getAllArticles();
---

<BaseLayout
  title="Notes & Case Studies"
  description="Engineering case studies, cloud infrastructure breakdowns, and technical notes by Guganraj Rengaraju."
>
  <div class="space-y-6 sm:space-y-7">
    <!-- Hero / Introduction -->
    <section class="space-y-3">
      <div class="flex items-center gap-2">
        <span class="inline-flex items-center gap-1.5 rounded-md border border-border/60 bg-muted/40 px-2 py-0.5 text-xs font-medium text-secondary">
          <span class="h-1.5 w-1.5 rounded-full bg-emerald-500 animate-pulse shrink-0" aria-hidden="true"></span>
          <span>Notes & Engineering Explorations</span>
        </span>
      </div>

      <h1 class="text-xl sm:text-2xl font-bold tracking-tight text-primary leading-tight">
        Things I build, learn, explore, and think about.
      </h1>

      <p class="text-xs sm:text-sm text-secondary leading-relaxed max-w-2xl">
        A personal archive of systems architecture, production cloud deployments, open-source work, and technical discoveries by <a href={siteConfig.portfolioUrl} target="_blank" class="text-primary hover:underline font-medium">{siteConfig.author}</a>.
      </p>

      <!-- Category Filter Buttons -->
      <div class="flex flex-wrap items-center gap-1.5 pt-1">
        <a
          href="/"
          class="inline-flex items-center rounded-lg border border-border/80 bg-muted px-3 py-1.5 text-xs font-semibold text-primary shadow-xs transition-colors"
        >
          All
        </a>
        {Object.values(siteConfig.categories).map((cat) => (
          <a
            href={`/${cat.slug}`}
            class="inline-flex items-center rounded-lg border border-border/60 bg-card/80 px-3 py-1.5 text-xs font-medium text-secondary hover:text-primary hover:bg-muted/60 transition-colors"
          >
            {cat.title}
          </a>
        ))}
      </div>
    </section>

    <PencilDivider />

    <!-- Recent Articles Feed -->
    <section class="space-y-3">
      <div class="flex items-center justify-between">
        <h2 class="text-xs sm:text-sm font-semibold tracking-tight text-primary">
          Recent Writing
        </h2>
        <span class="text-xs text-secondary/70 font-mono">
          {allArticles.length} article{allArticles.length === 1 ? '' : 's'}
        </span>
      </div>

      {recentArticles.length === 0 ? (
        <div class="py-10 text-center rounded-[14px] border border-dashed border-border/60 bg-card/40">
          <p class="text-xs text-secondary">Articles coming soon.</p>
        </div>
      ) : (
        <div class="space-y-2.5">
          {recentArticles.map((article) => (
            <ArticleCard article={article} />
          ))}
        </div>
      )}
    </section>
  </div>
</BaseLayout>
